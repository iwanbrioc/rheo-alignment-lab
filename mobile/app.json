{
  "expo": {
    "name": "Rheo",
    "slug": "rheo-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rheo to use your location while you are making a decision so it can look for nearby practical options."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Rheo to record a short voice note when you tap the microphone. You choose whether to send it for transcription.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D2328",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.rheo.mobile"
    },
    "android": {
      "package": "org.rheo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0D2328"
      }
    }
  }
}
