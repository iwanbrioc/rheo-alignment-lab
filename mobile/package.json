{
  "name": "rheo-mobile",
  "version": "0.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "smoke:local": "node smoke_local_context.mjs && node smoke_decision_sessions.mjs",
    "doctor": "npx expo-doctor@latest",
    "test:mesh": "node --test tests/mesh.test.mjs tests/replication.test.mjs tests/discovery.test.mjs",
    "export:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-calendar": "~57.0.5",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-location": "~57.0.22",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
